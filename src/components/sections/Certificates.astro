---
import { getLangFromUrl, useCV, useHeadersTranslations } from "@/utils";
import Section from "../Section.astro";

const lang = getLangFromUrl(Astro.url);
const headers = useHeadersTranslations(lang);
const { certificates } = await useCV(lang);
---

<Section title={headers.certificates}>
  <ul>
    {
      certificates.map(({ name, issuer, date, url }) => {
        const formattedDate = new Date(date)
          .toLocaleDateString(lang, {
            month: "short",
            year: "numeric",
          })
          .replace(/^./, (char) => char.toUpperCase());

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>
                    <a href={url} target="_blank" rel="noopener noreferrer">
                      {name}
                    </a>
                  </h3>
                  <p>{issuer}</p>
                </div>

                <time>{formattedDate}</time>
              </header>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article a {
    text-decoration: none;
    color: inherit;
  }

  article a:hover {
    text-decoration: underline;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  p {
    color: #555;
    font-size: 0.9rem;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>
